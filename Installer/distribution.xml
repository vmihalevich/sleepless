<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
    <title>Sleepless</title>
    <welcome file="welcome.html" mime-type="text/html"/>
    <options customize="never" require-scripts="false" hostArchitectures="arm64,x86_64"/>
    <domains enable_localSystem="true"/>
    <volume-check>
        <allowed-os-versions>
            <os-version min="14.0"/>
        </allowed-os-versions>
    </volume-check>
    <choices-outline>
        <line choice="default"/>
    </choices-outline>
    <choice id="default" title="Sleepless">
        <pkg-ref id="dev.mihalevich.sleepless"/>
    </choice>
    <pkg-ref id="dev.mihalevich.sleepless" version="@VERSION@" onConclusion="none">Sleepless.pkg</pkg-ref>
</installer-gui-script>
